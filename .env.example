# --- Zendesk ---
# Subdomínio da conta (https://<ZD_SUBDOMAIN>.zendesk.com)
ZD_SUBDOMAIN=con-renansanchez
# Subdomínios aceitos no token do getContext (a conta também responde pelo subdomínio original)
ZD_TOKEN_SUBDOMAINS=con-renansanchez,sisconsulting-14933
# Admin Center > Apps e integrações > APIs > Conversations API > Criar chave de API
SC_APP_ID=6862f287f6989f3ba72d41da
SC_KEY_ID=
SC_KEY_SECRET=
# Admin Center > Canais > Messaging > (seu Web Widget) > Instalação: valor de ?key= no snippet
ZENDESK_WIDGET_KEY=

# --- Este servidor ---
# URL pública HTTPS onde este servidor está acessível (ex.: túnel cloudflared/ngrok)
PUBLIC_BASE_URL=https://seu-tunel.trycloudflare.com
PORT=8080

# Segredo do webhook (Admin Center > Apps e integrações > Conversations API/Webhooks).
# Opcional: sem ele, a oferta só é enviada pelo script `npm run send-offer`.
WEBHOOK_SECRET=

# Só demo: mostra na página de teste um botão que envia o convite de gravação para a
# conversa aberta no widget. NÃO usar em produção (aceita conversationId do navegador).
DEMO_OFFER_ENDPOINT=true

# Só demo: o JWKS da conta (/.well-known/jwks.json) estava vazio em 27/10/2026. Se o token do
# getContext não puder ser verificado por isso, "true" aceita o token sem assinatura desde que a
# API confirme que o usuário participa da conversa. NÃO usar em produção.
DEMO_ALLOW_UNVERIFIED_CONTEXT=false

# --- Limites (RF-010) ---
MAX_DURATION_SEC=180
MAX_BYTES=10485760

# Origens que podem embutir o gravador (CSP frame-ancestors). "*" só para demo.
FRAME_ANCESTORS=*
